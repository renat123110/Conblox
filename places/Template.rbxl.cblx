                          },
                          {
                            "id": "inst_3957_mr1v3d",
                            "name": "Replace",
                            "className": "Folder",
                            "archivable": true,
                            "attributes": {},
                            "tags": [],
                            "properties": {},
                            "children": [
                              {
                                "id": "inst_3958_bb0vyd",
                                "name": "FirstPerson",
                                "className": "LocalScript",
                                "archivable": true,
                                "attributes": {},
                                "tags": [],
                                "properties": {
                                  "source": "-- LocalScript \u00e2\u0086\u0092 StarterPlayerScripts\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal player = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\nlocal mouse = player:GetMouse()\n\n-- ====================== \u00d0\u009d\u00d0\u0090\u00d0\u00a1\u00d0\u00a2\u00d0\u00a0\u00d0\u009e\u00d0\u0099\u00d0\u009a\u00d0\u0098 ======================\nlocal SENSITIVITY = 0.2\nlocal MAX_PITCH = 80\nlocal FOV = 75\n\nlocal CanViewBody = false\n\nlocal SWAY_SMOOTHNESS = 8\nlocal SWAY_MOUSE_AMOUNT = 0.0025\nlocal SWAY_MOVE_AMOUNT = 0.03\nlocal BOB_AMOUNT = 0.05\nlocal BOB_SPEED = 10\n\nlocal EYE_OFFSET = CFrame.new(0, 0.08, 0.15)   -- \u00d0\u00bf\u00d0\u00be\u00d0\u00b4\u00d0\u00b1\u00d0\u00b5\u00d1\u0080\u00d0\u00b8 \u00d0\u00bf\u00d0\u00be\u00d0\u00b4 \u00d1\u0081\u00d0\u00b2\u00d0\u00be\u00d0\u00b9 \u00d1\u0080\u00d0\u00b8\u00d0\u00b3\n\n-- ====================== \u00d0\u0098\u00d0\u009d\u00d0\u0098\u00d0\u00a6\u00d0\u0098\u00d0\u0090\u00d0\u009b\u00d0\u0098\u00d0\u0097\u00d0\u0090\u00d0\u00a6\u00d0\u0098\u00d0\u00af ======================\nlocal yaw, pitch = 0, 0\nlocal freemouse = false\n\nlocal function setupCamera()\n\tcamera.CameraType = Enum.CameraType.Scriptable\n\tplayer.CameraMode = Enum.CameraMode.LockFirstPerson\n\tUserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter\n\tUserInputService.MouseIconEnabled = false\n\tmouse.Icon = \"http://www.roblox.com/asset/?id=569021388\"\nend\nsetupCamera()\n\nlocal character = player.Character\nlocal humanoid = character:WaitForChild(\"Humanoid\")\nlocal rootPart = character:WaitForChild(\"HumanoidRootPart\")\nhumanoid.AutoRotate = false\n\nlocal function updateCharacterVisibility()\n\tfor _, v in pairs(character:GetChildren()) do\n\t\tif v:IsA(\"BasePart\") or v:IsA(\"MeshPart\") or v:IsA(\"UnionOperation\") then\n\t\t\tif v.Name == \"Head\" or v.Name == \"HumanoidRootPart\" then\n\t\t\t\tv.LocalTransparencyModifier = 1\n\t\t\t\tv.CanCollide = false\n\t\t\telse\n\t\t\t\tv.LocalTransparencyModifier = CanViewBody and 0 or 1\n\t\t\tend\n\t\telseif v:IsA(\"Accessory\") or v:IsA(\"Hat\") then\n\t\t\tlocal handle = v:FindFirstChild(\"Handle\")\n\t\t\tif handle then\n\t\t\t\thandle.LocalTransparencyModifier = 1\n\t\t\t\thandle.CanCollide = false\n\t\t\tend\n\t\tend\n\tend\nend\n\n-- ====================== VIEWMODEL ======================\nlocal rig = character:WaitForChild(\"Viewmodel\")\nfor _, part in ipairs(rig:GetDescendants()) do\n\tif part:IsA(\"BasePart\") then\n\t\tpart.CanCollide = false\n\t\tpart.CanTouch = false\n\t\tpart.CanQuery = false\n\t\tpart.Massless = true\n\tend\nend\nrig.Parent = camera\n\nlocal cameraHumanoid = rig:WaitForChild(\"Humanoid\")\nlocal animator = cameraHumanoid:WaitForChild(\"Animator\")\n\nlocal animations = {\n\tIdle   = animator:LoadAnimation(script:WaitForChild(\"Idle\")),\n\tWalk   = animator:LoadAnimation(script:WaitForChild(\"Walk\")),\n\tAttack = animator:LoadAnimation(script:WaitForChild(\"Attack\")),\n}\n\n-- === \u00d0\u00a3\u00d0\u00a1\u00d0\u00a2\u00d0\u0090\u00d0\u009d\u00d0\u009e\u00d0\u0092\u00d0\u009a\u00d0\u0090 \u00d0\u009f\u00d0\u00a0\u00d0\u0098\u00d0\u009e\u00d0\u00a0\u00d0\u0098\u00d0\u00a2\u00d0\u0095\u00d0\u00a2\u00d0\u009e\u00d0\u0092 (\u00d1\u0081\u00d0\u00b0\u00d0\u00bc\u00d0\u00be\u00d0\u00b5 \u00d0\u00b2\u00d0\u00b0\u00d0\u00b6\u00d0\u00bd\u00d0\u00be\u00d0\u00b5) ===\nanimations.Idle.Priority   = Enum.AnimationPriority.Idle\nanimations.Walk.Priority   = Enum.AnimationPriority.Movement\nanimations.Attack.Priority = Enum.AnimationPriority.Action4   -- \u00d0\u00b8\u00d0\u00bb\u00d0\u00b8 Action3 / Action \u00d0\u00b5\u00d1\u0081\u00d0\u00bb\u00d0\u00b8 \u00d0\u00bd\u00d1\u0083\u00d0\u00b6\u00d0\u00bd\u00d0\u00be\n\n-- \u00d0\u0097\u00d0\u00b0\u00d0\u00bf\u00d1\u0083\u00d1\u0081\u00d0\u00ba\u00d0\u00b0\u00d0\u00b5\u00d0\u00bc Idle \u00d0\u00b8 Walk \u00d0\u009d\u00d0\u0090\u00d0\u0092\u00d0\u00a1\u00d0\u0095\u00d0\u0093\u00d0\u0094\u00d0\u0090 (\u00d0\u00b4\u00d0\u00bb\u00d1\u008f \u00d0\u00bf\u00d0\u00bb\u00d0\u00b0\u00d0\u00b2\u00d0\u00bd\u00d0\u00be\u00d0\u00b3\u00d0\u00be \u00d0\u00b1\u00d0\u00bb\u00d0\u00b5\u00d0\u00bd\u00d0\u00b4\u00d0\u00b0)\nanimations.Idle:Play(0)\nanimations.Walk:Play(0)\nanimations.Attack:AdjustWeight(0, 0)   -- Attack \u00d0\u00bd\u00d0\u00b0\u00d1\u0087\u00d0\u00b8\u00d0\u00bd\u00d0\u00b0\u00d0\u00b5\u00d1\u0082\u00d1\u0081\u00d1\u008f \u00d0\u00b2\u00d1\u008b\u00d0\u00ba\u00d0\u00bb\u00d1\u008e\u00d1\u0087\u00d0\u00b5\u00d0\u00bd\u00d0\u00bd\u00d1\u008b\u00d0\u00bc\n\nlocal head = rig:WaitForChild(\"Head\")\n\n-- ====================== SWAY / BOB ======================\nlocal swayOffset = Vector3.new()\nlocal swayRotation = Vector3.new()\nlocal bobTime = 0\n\n-- ====================== INPUT ======================\nUserInputService.InputChanged:Connect(function(input, gpe)\n\tif gpe or freemouse then return end\n\tif input.UserInputType == Enum.UserInputType.MouseMovement then\n\t\tyaw -= input.Delta.X * SENSITIVITY\n\t\tpitch = math.clamp(pitch - input.Delta.Y * SENSITIVITY, -MAX_PITCH, MAX_PITCH)\n\tend\nend)\n\nUserInputService.InputBegan:Connect(function(input, gpe)\n\tif gpe then return end\n\tif input.UserInputType == Enum.UserInputType.MouseButton1 then\n\t\tanimations.Attack:Play(0.2)   -- \u00d0\u00b2\u00d1\u008b\u00d1\u0081\u00d0\u00be\u00d0\u00ba\u00d0\u00b8\u00d0\u00b9 \u00d0\u00bf\u00d1\u0080\u00d0\u00b8\u00d0\u00be\u00d1\u0080\u00d0\u00b8\u00d1\u0082\u00d0\u00b5\u00d1\u0082 \u00e2\u0080\u0094 \u00d0\u00bd\u00d0\u00b5 \u00d1\u0082\u00d1\u0080\u00d0\u00be\u00d0\u00b3\u00d0\u00b0\u00d0\u00b5\u00d1\u0082 Idle/Walk\n\tend\nend)\n\n-- ====================== MAIN LOOP ======================\nRunService.RenderStepped:Connect(function(dt)\n\tif not character or not character.Parent or not rig then return end\n\n\tupdateCharacterVisibility()\n\n\tlocal rootPos = rootPart.Position\n\tlocal velocity = rootPart.Velocity\n\tlocal moveSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude\n\n\tlocal charRotation = CFrame.fromOrientation(0, math.rad(yaw), 0)\n\trootPart.CFrame = CFrame.new(rootPos) * charRotation\n\n\t-- SWAY \u00d0\u00be\u00d1\u0082 \u00d0\u00bc\u00d1\u008b\u00d1\u0088\u00d0\u00b8\n\tlocal mouseDelta = UserInputService:GetMouseDelta()\n\tlocal targetSwayRot = Vector3.new(\n\t\t-mouseDelta.Y * SWAY_MOUSE_AMOUNT,\n\t\t-mouseDelta.X * SWAY_MOUSE_AMOUNT,\n\t\t-mouseDelta.X * SWAY_MOUSE_AMOUNT * 0.5\n\t)\n\tswayRotation = swayRotation:Lerp(targetSwayRot, dt * SWAY_SMOOTHNESS)\n\n\t-- SWAY \u00d0\u00be\u00d1\u0082 \u00d0\u00b4\u00d0\u00b2\u00d0\u00b8\u00d0\u00b6\u00d0\u00b5\u00d0\u00bd\u00d0\u00b8\u00d1\u008f\n\tlocal moveDir = humanoid.MoveDirection\n\tlocal targetMoveSway = Vector3.new(\n\t\t-moveDir.Z * SWAY_MOVE_AMOUNT,\n\t\t-moveDir.X * SWAY_MOVE_AMOUNT,\n\t\t0\n\t)\n\tswayOffset = swayOffset:Lerp(targetMoveSway, dt * SWAY_SMOOTHNESS)\n\n\t-- HEAD BOB\n\tlocal bobOffset = Vector3.new()\n\tif moveSpeed > 1 then\n\t\tbobTime += dt * BOB_SPEED\n\t\tbobOffset = Vector3.new(\n\t\t\tmath.sin(bobTime) * BOB_AMOUNT,\n\t\t\tmath.abs(math.cos(bobTime)) * BOB_AMOUNT * 0.6,\n\t\t\t0\n\t\t)\n\tend\n\n\tlocal swayCFrame = CFrame.new(swayOffset + bobOffset) * CFrame.Angles(swayRotation.X, swayRotation.Y, swayRotation.Z)\n\tlocal camRotation = CFrame.fromOrientation(math.rad(pitch), math.rad(yaw), 0)\n\tlocal rigCFrame = CFrame.new(rootPos) * camRotation * swayCFrame\n\n\trig:PivotTo(rigCFrame)\n\n\t-- === \u00d0\u009f\u00d0\u009b\u00d0\u0090\u00d0\u0092\u00d0\u009d\u00d0\u00ab\u00d0\u0099 \u00d0\u0091\u00d0\u009b\u00d0\u0095\u00d0\u009d\u00d0\u0094 IDLE \u00e2\u0086\u0094 WALK (\u00d0\u00b2\u00d1\u0081\u00d0\u00b5\u00d0\u00b3\u00d0\u00b4\u00d0\u00b0 \u00d0\u00b8\u00d0\u00b3\u00d1\u0080\u00d0\u00b0\u00d1\u008e\u00d1\u0082) ===\n\tlocal idleWeight  = (moveSpeed > 1) and 0 or 1\n\tlocal walkWeight  = (moveSpeed > 1) and 1 or 0\n\n\tanimations.Idle:AdjustWeight(idleWeight, 0.25)   -- 0.25 \u00d1\u0081\u00d0\u00b5\u00d0\u00ba \u00d0\u00bd\u00d0\u00b0 \u00d0\u00bf\u00d0\u00b5\u00d1\u0080\u00d0\u00b5\u00d1\u0085\u00d0\u00be\u00d0\u00b4 \u00e2\u0080\u0094 \u00d0\u00be\u00d1\u0087\u00d0\u00b5\u00d0\u00bd\u00d1\u008c \u00d0\u00bf\u00d0\u00bb\u00d0\u00b0\u00d0\u00b2\u00d0\u00bd\u00d0\u00be\n\tanimations.Walk:AdjustWeight(walkWeight, 0.25)\n\n\t-- \u00d0\u009a\u00d0\u00b0\u00d0\u00bc\u00d0\u00b5\u00d1\u0080\u00d0\u00b0 \u00d1\u0081\u00d1\u0082\u00d1\u0080\u00d0\u00be\u00d0\u00b3\u00d0\u00be \u00d0\u00b7\u00d0\u00b0 \u00d0\u00b0\u00d0\u00bd\u00d0\u00b8\u00d0\u00bc\u00d0\u00b8\u00d1\u0080\u00d0\u00be\u00d0\u00b2\u00d0\u00b0\u00d0\u00bd\u00d0\u00bd\u00d0\u00be\u00d0\u00b9 \u00d0\u00b3\u00d0\u00be\u00d0\u00bb\u00d0\u00be\u00d0\u00b2\u00d0\u00be\u00d0\u00b9\n\tcamera.CFrame = head.CFrame * EYE_OFFSET\n\tcamera.FieldOfView = FOV\n\tcamera.CameraType = Enum.CameraType.Custom\n\n\tUserInputService.MouseBehavior = freemouse and Enum.MouseBehavior.Default or Enum.MouseBehavior.LockCenter\nend)",
                                  "enabled": false
                                },
                                "children": [
                                  {
                                    "id": "inst_3959_qxprgo",
                                    "name": "Attack",
