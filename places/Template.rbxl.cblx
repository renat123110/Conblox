      {
        "id": "inst_107_qjqv21",
        "name": "ServerScriptService",
        "className": "ServerScriptService",
        "archivable": true,
        "attributes": {},
        "tags": [],
        "properties": {},
        "children": [
          {
            "id": "inst_163_kamuwh",
            "name": "Server",
            "className": "Script",
            "archivable": true,
            "attributes": {},
            "tags": [],
            "properties": {
              "source": "local Players = game:GetService(\"Players\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\nlocal Modules = ServerStorage.Modules\n\nlocal KillersModule = require(Modules.Killers)\n\nPlayers.PlayerAdded:Connect(function(addedPlayer)\n\t\n\taddedPlayer.CharacterAdded:Connect(function(addedCharacter)\n\t\ttask.wait(1)\n\t\tif not addedCharacter:GetAttribute(\"Killer\") then\n\t\t\tKillersModule.new(addedCharacter,\"Jack Row\")\n\t\tend\n\t\t\n\tend)\n\t\nend)\n\nlocal AnimationClipProvider = game:GetService(\"AnimationClipProvider\")\nfor _,animation in pairs(game:GetDescendants()) do\n\tif animation:IsA(\"Animation\") and animation:FindFirstChildOfClass(\"KeyframeSequence\") then\n\t\tlocal Id = AnimationClipProvider:RegisterAnimationClip(animation:FindFirstChildOfClass(\"KeyframeSequence\"))\n\t\tanimation.AnimationId = Id\n\tend\nend",
              "enabled": true
            },
            "children": []
          }
        ]
      },
      {
        "id": "inst_108_320b6n",
        "name": "ServerStorage",
        "className": "ServerStorage",
        "archivable": true,
        "attributes": {},
        "tags": [],
        "properties": {},
        "children": [
          {
            "id": "inst_165_o21k29",
            "name": "Modules",
            "className": "Folder",
            "archivable": true,
            "attributes": {},
            "tags": [],
            "properties": {},
            "children": [
              {
                "id": "inst_166_zozwct",
                "name": "Killers",
                "className": "ModuleScript",
                "archivable": true,
                "attributes": {},
                "tags": [],
                "properties": {
                  "source": "local Players = game:GetService(\"Players\")\n\nlocal Killers = {}\nKillers.Data = {\n\t[\"Jack Row\"] = {\n\t\tSpeed = 15.5,\n\t},\n}\n\nlocal DEFAULT_KILLER = \"Jack Row\"\n\nfunction Killers.new(Character, Killer)\n\t\n\tif not Character then\n\t\treturn error(\"No Character to take Killer\")\n\tend\n\tif not Killer then\n\t\tKiller = DEFAULT_KILLER\n\tend\t\n\tlocal v1 = script:FindFirstChild(Killer)\n\tif v1 then\n\telse\n\t\treturn error(\"\u00d0\u009d\u00d0\u00b5 \u00d0\u00bd\u00d0\u00b0\u00d0\u00b9\u00d0\u00b4\u00d0\u00b5\u00d0\u00bd Killer_Module\")\n\tend\n\t\n\tlocal KillerModule : ModuleScript = v1\n\trequire(KillerModule)(Character)\n\t\nend\n\nreturn Killers"
                },
                "children": [
                  {
                    "id": "inst_167_s4wtaj",
                    "name": "Jack Row",
                    "className": "ModuleScript",
                    "archivable": true,
                    "attributes": {},
                    "tags": [],
                    "properties": {
                      "source": "local Players = game:GetService(\"Players\")\nlocal Assets = script:WaitForChild(\"Assets\")\n\nreturn function(character)\n\tlocal player = Players:GetPlayerFromCharacter(character)\n\tif not player or not character or not character.PrimaryPart then return end\n\n\tlocal spawnCFrame = character.PrimaryPart.CFrame\n\tlocal newCharacter = Assets.StarterCharacter:Clone()\n\n\tnewCharacter:SetAttribute(\"Killer\", true)\n\tnewCharacter.Name = player.Name\n\n\tnewCharacter:PivotTo(spawnCFrame)\n\tnewCharacter.Parent = workspace\n\n\tplayer.Character = newCharacter\n\tcharacter:Destroy()\n\t\n\tfor _,v in Assets.Replace:GetChildren() do\n\t\tlocal clone = v:Clone()\n\t\tclone.Parent = player.Character\n\t\tif clone:IsA(\"LocalScript\") then\n\t\t\tclone.Enabled = true\n\t\tend\n\tend\n\t\nend\n\nfor _,v in newCharacter:FindFirstChild(\"Viewmodel\"):GetDescendants() do\n\tif v:IsA(\"Part\") or v:IsA(\"MeshPart\") then\n\t\tv.Transparency = 0\n\tend\nend"
                    },
                    "children": [
                      {
                        "id": "inst_168_5om6o3",
