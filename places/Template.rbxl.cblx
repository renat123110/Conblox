            "children": [
              {
                "id": "inst_11643_8wykqd",
                "name": "CameraFix",
                "className": "LocalScript",
                "archivable": true,
                "attributes": {},
                "tags": [],
                "properties": {
                  "source": "local Players = game:GetService(\"Players\")\nlocal Player = Players.LocalPlayer\nlocal Camera = workspace.CurrentCamera\n\nPlayer.CharacterAdded:Connect(function(addedCharacter)\n\tCamera.CameraSubject = addedCharacter:FindFirstChildOfClass(\"Humanoid\")\nend)",
                  "enabled": true
                },
                "children": []
              },
              {
                "id": "inst_11644_gmloy0",
                "name": "Replication",
                "className": "LocalScript",
                "archivable": true,
                "attributes": {},
                "tags": [],
                "properties": {
                  "source": "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Replicate = ReplicatedStorage.Replicate\n\nReplicate.OnClientEvent:Connect(function(Type,Data,args)\n\tif Type == \"Signal\" then\n\t\t\n\tend\nend)",
                  "enabled": true
                },
                "children": [
                  {
                    "id": "inst_11645_ccc7lj",
                    "name": "KillersAssets",
                    "className": "ModuleScript",
                    "archivable": true,
                    "attributes": {},
                    "tags": [],
                    "properties": {
                      "source": "local module = {}\n\nreturn module\n"
                    },
                    "children": []
                  }
                ]
              }
            ]
